{
  "cases": [
    {
      "id": "first-window-from-the-plan-applied-to-the-next-boundary",
      "note": "The same plan keeps its window; a plan changed past the boundary opens no window for the old plan.",
      "plans": [
        "sixty-seconds",
        "five-minutes"
      ],
      "events": [
        {
          "hold": {
            "plan": "sixty-seconds",
            "at": 20
          }
        },
        {
          "hold": {
            "plan": "sixty-seconds",
            "at": 30
          }
        },
        {
          "hold": {
            "plan": "five-minutes",
            "at": 61
          }
        },
        {
          "hold": {
            "plan": null,
            "at": 70
          }
        }
      ],
      "expect": [
        {
          "closed": null,
          "open_until": 60
        },
        {
          "closed": null,
          "open_until": 60
        },
        {
          "closed": {
            "plan": "sixty-seconds",
            "start": 20,
            "end": 60,
            "calls_at": [],
            "calls_dropped": 0
          },
          "open_until": 300
        },
        {
          "closed": {
            "plan": "five-minutes",
            "start": 61,
            "end": 70,
            "calls_at": [],
            "calls_dropped": 0
          },
          "open_until": null
        }
      ]
    },
