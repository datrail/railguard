    "queryParameters": {
      "sandbox_name": {
        "equalTo": "e2e-sandbox"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "ticket.json"
  }
}
