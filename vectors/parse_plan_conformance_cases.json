      "expect": {"valid": false}
    },
    {
      "name": "a catch-all's path_prefix of 0 segments",
      "patch": [{"op": "replace", "path": "/catch_all/record/context_keys/1/segments", "value": 0}],
      "expect": {"valid": false}
    },
    {
      "name": "a catch-all's two hosts",
      "patch": [{"op": "add", "path": "/catch_all/record/context_keys/-", "value": {"name": "host"}}],
      "expect": {"valid": false}
    },
    {
      "name": "a catch-all's measure beside the three",
      "patch": [{"op": "add", "path": "/catch_all/record/measure/-", "value": {"name": "argument_bytes", "type": "sum", "function": "size", "paths": [["request", "body", "params", "arguments", "content"]]}}],
      "expect": {"valid": false}
    },
    {
      "name": "a catch-all without error_count",
      "patch": [{"op": "remove", "path": "/catch_all/record/measure/1"}],
      "expect": {"valid": false}
    }
  ]
