  "cases": [
    {
      "name": "the plan as written: nothing refused, each host's entries",
      "patch": [],
      "expect": {"refused": {}, "entries_skipped": 0}
    },
    {
      "name": "an op this reader doesn't know refuses its entry, on its host",
      "patch": [{"op": "replace", "path": "/entries/1/match/3/op", "value": "starts_with"}],
      "expect": {"refused": {"e2": "condition 3: unknown_op"}, "entries_skipped": 1}
    },
    {
      "name": "a refused entry hides its host's later entries",
      "patch": [{"op": "replace", "path": "/entries/0/match/3/op", "value": "starts_with"}],
      "expect": {"refused": {"e1": "condition 3: unknown_op"}, "entries_skipped": 2}
    },
    {
      "name": "a refused entry naming no host is a barrier for every host",
      "patch": [{"op": "remove", "path": "/entries/0/match/0"}],
      "expect": {"refused": {"e1": "not_one_endpoint"}, "entries_skipped": 3}
    },
    {
      "name": "a barrier last hides nothing",
      "patch": [{"op": "remove", "path": "/entries/2/match/0"}],
      "expect": {"refused": {"e3": "not_one_endpoint"}, "entries_skipped": 1}
    },
    {
      "name": "a host condition that doesn't read makes a barrier",
      "patch": [{"op": "replace", "path": "/entries/0/match/0/path", "value": ["request", "host", "name"]}],
      "expect": {"refused": {"e1": "condition 0: invalid"}, "entries_skipped": 3}
    },
    {
      "name": "a header condition: not for a plan's match",
      "patch": [{"op": "add", "path": "/entries/1/match/-", "value": {"path": ["request", "headers", "x-team"], "op": "eq", "value": "a"}}],
      "expect": {"refused": {"e2": "condition 4: not_for_use"}, "entries_skipped": 1}
    },
    {
      "name": "a ticket condition: not for a plan's match",
      "patch": [{"op": "add", "path": "/entries/1/match/-", "value": {"path": ["ticket", "team"], "op": "eq", "value": "a"}}],
      "expect": {"refused": {"e2": "condition 4: not_for_use"}, "entries_skipped": 1}
    },
    {
      "name": "the endpoint key: not for a plan's match",
      "patch": [{"op": "add", "path": "/entries/1/match/-", "value": {"path": ["request", "endpoint_key"], "op": "existing"}}],
      "expect": {"refused": {"e2": "condition 4: not_for_use"}, "entries_skipped": 1}
    },
    {
      "name": "a path segment: a record's, not a match's",
      "patch": [{"op": "add", "path": "/entries/1/match/-", "value": {"path": ["request", "redacted_path", 0], "op": "eq", "value": "mcp"}}],
      "expect": {"refused": {"e2": "condition 4: not_for_use"}, "entries_skipped": 1}
    },
    {
      "name": "a query parameter: a record's, not a match's",
      "patch": [{"op": "add", "path": "/entries/1/match/-", "value": {"path": ["request", "query", "q"], "op": "existing"}}],
      "expect": {"refused": {"e2": "condition 4: not_for_use"}, "entries_skipped": 1}
    },
    {
      "name": "a condition that isn't one refuses its entry",
      "patch": [{"op": "add", "path": "/entries/1/match/-", "value": "eq"}],
      "expect": {"refused": {"e2": "condition 4: invalid"}, "entries_skipped": 1}
    },
    {
      "name": "an in with no value refuses its entry",
      "patch": [{"op": "add", "path": "/entries/1/match/-", "value": {"path": ["request", "body", "params", "arguments", "repo"], "op": "in", "value": []}}],
      "expect": {"refused": {"e2": "condition 4: invalid"}, "entries_skipped": 1}
    },
    {
      "name": "the first refused condition is the entry's refusal",
      "patch": [{"op": "replace", "path": "/entries/1/match/2/op", "value": "starts_with"}, {"op": "add", "path": "/entries/1/match/-", "value": {"path": ["ticket", "team"], "op": "eq", "value": "a"}}],
      "expect": {"refused": {"e2": "condition 2: unknown_op"}, "entries_skipped": 1}
    },
    {
