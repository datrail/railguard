              "paths": [
                [
                  "request",
                  "body",
                  "params",
                  "arguments",
                  "content"
                ]
              ]
            }
          ]
        }
      }
    ],
    "catch_all": {
      "id": "catch_all",
      "record": {
        "context_keys": [
          {
            "name": "host"
          },
          {
            "name": "path_prefix",
            "segments": 1
          },
          {
            "name": "method"
          },
          {
            "name": "operation"
          }
        ],
        "measure": [
          {
            "name": "call_count"
          },
          {
            "name": "error_count"
          },
          {
            "name": "request_bytes",
            "type": "sum",
