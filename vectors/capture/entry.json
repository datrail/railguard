{
  "cases": [
    {
      "id": "one-condition-holding-holds",
      "environment": "capture-sample",
      "match": [
        {
          "path": [
            "request",
            "host"
          ],
          "op": "eq",
          "value": "api.github.com"
        }
      ],
      "expect": "holds"
    },
    {
      "id": "every-condition-holding-holds",
      "environment": "capture-sample",
      "match": [
        {
          "path": [
            "request",
            "host"
          ],
          "op": "eq",
          "value": "api.github.com"
        },
        {
          "path": [
            "request",
            "method"
          ],
          "op": "eq",
          "value": "POST"
        },
        {
          "path": [
            "request",
            "mcp",
            "tool"
          ],
          "op": "eq",
          "value": "create_or_update_file"
        }
      ],
      "expect": "holds"
    },
    {
      "id": "one-condition-not-holding-does-not-hold",
      "environment": "capture-sample",
      "match": [
        {
          "path": [
            "request",
            "host"
          ],
          "op": "eq",
          "value": "api.github.com"
        },
        {
          "path": [
            "request",
            "mcp",
            "tool"
          ],
          "op": "eq",
          "value": "delete_file"
        }
      ],
      "expect": "does_not_hold"
    },
    {
      "id": "ambiguous-and-the-rest-holding-is-ambiguous",
      "environment": "capture-sample",
      "match": [
        {
          "path": [
            "request",
            "host"
          ],
          "op": "eq",
          "value": "api.github.com"
        },
        {
          "path": [
            "request",
            "body",
            "params",
            "arguments",
            "labels"
          ],
          "op": "existing"
        }
      ],
      "expect": "ambiguous"
    },
    {
      "id": "ambiguous-then-not-holding-does-not-hold",
      "note": "A condition that doesn't hold decides, after one that can't be told.",
      "environment": "capture-body-values",
      "match": [
        {
          "path": [
            "request",
            "body",
            "dup"
          ],
          "op": "eq",
          "value": 1
        },
        {
          "path": [
            "request",
            "body",
            "esc"
          ],
          "op": "eq",
          "value": "x"
        }
      ],
      "expect": "does_not_hold"
    },
    {
      "id": "not-holding-then-ambiguous-does-not-hold",
      "environment": "capture-body-values",
      "match": [
        {
          "path": [
            "request",
            "body",
            "esc"
          ],
          "op": "eq",
          "value": "x"
        },
        {
          "path": [
            "request",
            "body",
            "dup"
          ],
          "op": "eq",
          "value": 1
        }
      ],
      "expect": "does_not_hold"
    },
    {
      "id": "body-unread-and-the-request-line-holding-is-body-unread",
      "environment": "capture-body-not-sent",
      "match": [
        {
          "path": [
            "request",
            "host"
          ],
          "op": "eq",
          "value": "mcp.example.com"
        },
        {
          "path": [
            "request",
            "mcp",
            "tool"
          ],
          "op": "eq",
          "value": "create_or_update_file"
        }
      ],
      "expect": {
        "body_unread": {
          "unread": "not_sent"
        }
      }
    },
    {
      "id": "first-untold-of-two-is-the-answer-unread",
      "note": "Of conditions that can't be told, the first evaluated is the answer.",
      "environment": "capture-body-batch-holding-what-cant-be-told",
      "match": [
        {
          "path": [
            "request",
            "mcp",
            "tool"
          ],
          "op": "existing"
        },
        {
          "path": [
            "request",
            "body",
            1
          ],
          "op": "existing"
        }
      ],
      "expect": {
        "body_unread": "batch"
      }
    },
    {
      "id": "first-untold-of-two-is-the-answer-ambiguous",
      "environment": "capture-body-batch-holding-what-cant-be-told",
      "match": [
        {
          "path": [
            "request",
            "body",
            1
          ],
          "op": "existing"
        },
        {
          "path": [
            "request",
            "mcp",
            "tool"
          ],
          "op": "existing"
        }
      ],
      "expect": "ambiguous"
    },
    {
      "id": "a-condition-holding-after-one-that-cant-be-told-is-ambiguous",
      "note": "A condition that holds leaves what couldn't be told standing.",
      "environment": "capture-body-values",
      "match": [
        {
          "path": [
            "request",
            "body",
            "dup"
          ],
          "op": "eq",
          "value": 1
        },
        {
          "path": [
            "request",
            "body",
            "esc"
          ],
          "op": "eq",
          "value": "payroll"
        }
      ],
      "expect": "ambiguous"
    },
    {
      "id": "unread-then-not-holding-does-not-hold",
      "environment": "capture-body-batch-holding-what-cant-be-told",
      "match": [
        {
          "path": [
            "request",
            "mcp",
            "tool"
          ],
          "op": "existing"
        },
        {
          "path": [
            "request",
            "body",
            0,
            "method"
          ],
          "op": "eq",
          "value": "x"
        }
      ],
      "expect": "does_not_hold"
    },
    {
      "id": "body-unread-then-holding-is-body-unread",
      "environment": "capture-body-not-sent",
      "match": [
        {
          "path": [
            "request",
            "mcp",
            "tool"
          ],
          "op": "existing"
        },
        {
          "path": [
            "request",
            "body",
            "x"
          ],
          "op": "not_existing"
        }
      ],
      "expect": {
        "body_unread": {
          "unread": "not_sent"
        }
      }
    },
    {
      "id": "not-holding-then-body-unread-does-not-hold",
      "environment": "capture-body-batch-holding-what-cant-be-told",
      "match": [
        {
          "path": [
            "request",
            "body",
            0,
            "method"
          ],
          "op": "eq",
          "value": "x"
        },
        {
          "path": [
            "request",
            "mcp",
            "tool"
          ],
          "op": "existing"
        }
      ],
      "expect": "does_not_hold"
    },
    {
      "id": "a-refusal-decides-after-what-cant-be-told",
      "note": "dup costs 11 steps and can't be told; esc then passes the limit.",
      "environment": "capture-body-values",
      "match": [
        {
          "path": [
            "request",
            "body",
            "dup"
          ],
          "op": "eq",
          "value": 1
        },
        {
          "path": [
            "request",
            "body",
            "esc"
          ],
          "op": "eq",
          "value": "payroll"
        }
      ],
      "step_limit": 15,
      "expect": {
        "refused": "budget_exceeded"
      }
    },
    {
      "id": "the-request-lines-conditions-are-evaluated-before-the-bodys",
      "note": "In plan order, the body's key would pass the limit first.",
      "environment": "capture-body-ten-members",
      "match": [
        {
          "path": [
            "request",
            "body",
            "a"
          ],
          "op": "existing"
        },
        {
          "path": [
            "request",
            "host"
          ],
          "op": "eq",
          "value": "other.example.com"
        }
      ],
      "step_limit": 5,
      "expect": "does_not_hold"
    }
  ]
}
